# Ethereum RPC (Infura or Alchemy) — required for live mode only
INFURA_API_KEY=your_api_key_here

# Generic action webhook — optional, POST on opportunity detection
# Example: Slack incoming webhook, n8n, Zapier, or your own execution API
# Slack: https://api.slack.com/messaging/webhooks
ACTION_WEBHOOK_URL=

# Optional overrides
# CONFIG_PATH=configs/config.yaml
# LOG_LEVEL=info
